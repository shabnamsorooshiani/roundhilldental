{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "browserslist": [
    "chrome >0, last 2.5 years",
    "edge >0, last 2.5 years",
    "safari >0, last 2.5 years",
    "firefox >0, last 2.5 years",
    "and_chr >0, last 2.5 years",
    "and_ff >0, last 2.5 years",
    "ios >0, last 2.5 years",
    "not dead"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "export": "next export",
    "start": "npx serve out",
    "sitemap": "next-sitemap --config ./next-sitemap.config.js",
    "postbuild": "next-sitemap --config ./next-sitemap.config.js",
    "format": "prettier --write \"src/**/*.{js,jsx,json,css,md}\"",
    "lint": "eslint \"src/**/*.{js,jsx,json,css,md}\" --quiet --no-cache",
    "ci:format": "prettier --check \"src/**/*.{js,jsx,json,css,md}\"",
    "ci:lint": "eslint --no-cache \"src/**/*.{js,jsx,json,css,md}\""
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^1.16.6",
    "axios": "^1.6.8",
    "cross-env": "^7.0.3",
    "file-saver": "^2.0.5",
    "next": "14.1.0",
    "next-sitemap": "^4.2.3",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.51.1",
    "react-markdown": "^9.0.1",
    "react-spinners": "^0.13.8",
    "react-toastify": "^10.0.5",
    "remark-gfm": "^4.0.0",
    "swiper": "^11.1.11",
    "sharp": "^0.33.3"
  },
  "devDependencies": {
    "@softonus/prettier-plugin-duplicate-remover": "^1.0.1",
    "@softonus/prettier-plugin-whitespace-remover": "^1.0.1",
    "postcss": "^8.4.18",
    "postcss-loader": "^8.1.1",
    "tailwindcss": "^3.2.2",
    "autoprefixer": "^10.4.13",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.1.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-tailwindcss": "^3.17.4",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.6"
  }
}
